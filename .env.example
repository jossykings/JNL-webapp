# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the real .env (it is git-ignored).
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
# Port the site listens on. 0/empty falls back to 3000.
PORT=3000
# Admin master key: signs into /#/admin with a blank email field. Use a long
# random value; without it admin login is disabled.
ADMIN_PASSWORD=
# Signs session tokens (HMAC). Use a long random value, e.g. `openssl rand -hex 32`.
# Without it every login is invalidated on restart.
SECRET=
# Public origin of the site. Used for Stripe redirects and absolute links.
SITE_URL=http://localhost:3000
# Set to 1 behind a reverse proxy / load balancer so client IPs are read from
# X-Forwarded-For (rate limits, audit logs).
TRUST_PROXY=

# --- Payments (Stripe) -----------------------------------------------------
# Leave STRIPE_SECRET_KEY empty to run the labelled local SANDBOX provider
# (no card is charged, nothing is invented). Set real test/live keys to charge.
STRIPE_SECRET_KEY=
# Required for Stripe Elements to load on the checkout page (pk_test_… / pk_live_…).
STRIPE_PUBLISHABLE_KEY=
# From the Stripe webhook endpoint you create (whsec_…). Payments are only
# trusted when a signed webhook confirms them.
STRIPE_WEBHOOK_SECRET=
# Signing secret used by the sandbox provider and by the test suite.
SANDBOX_WEBHOOK_SECRET=whsec_sandbox_dev_only
# Settlement currency for the shop (Canadian dollars by default).
SHOP_CURRENCY=cad

# --- Carrier tracking (optional) -------------------------------------------
# When set, POST /api/webhooks/carrier accepts HMAC-signed shipment updates
# (header `x-carrier-signature`, same t=…,v1=… scheme as Stripe). When empty
# the endpoint returns 404 and shipments are maintained in the admin dashboard.
CARRIER_WEBHOOK_SECRET=

# --- Email notifications (optional) ----------------------------------------
# Order/invoice notifications are always stored in-app. When MAIL_WEBHOOK_URL is
# set they are also POSTed there so your provider (Resend, Postmark, SES, …)
# can deliver them. MAIL_WEBHOOK_TOKEN adds a bearer token.
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=
MAIL_FROM=
